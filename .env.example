# ==========================================
# AETHERIX — AFTER THE FIRE
# Environment Configuration Template
# ==========================================

# Primary basemap: MapTiler
# Register and get your key from https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=

# Alternative basemap: CARTO
# Preserve the previously supplied CARTO key here if CARTO remains configured.
VITE_CARTO_BASEMAPS_KEY=

# Optional: contact and feedback email
# Server-side only. Never prefix with VITE_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: live Sentinel-2 acquisition
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional: backend NISAR acquisition
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
