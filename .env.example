# ==========================================
# AETHERIX — AFTER THE FIRE
# Environment Configuration Template
# ==========================================

# PRIMARY MAP PROVIDER
# Register and get your key from https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=

# OPTIONAL ALTERNATIVE BASEMAP (Only if MapTiler is not used)
# https://carto.com/basemaps/apikey/
VITE_CARTO_BASEMAPS_KEY=

# CONTACT AND FEEDBACK EMAIL DELIVERY (RESEND)
# Register and get your key from https://resend.com/api-keys
# Server-side only. NEVER prefix with VITE_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# OPTIONAL: Sentinel Hub / Copernicus Earth Observation (Server-side only)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
